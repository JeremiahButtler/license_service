# --- Secrets & credentials - NEVER commit ---
.env
.env.*
*.pem
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
deploy_key
deploy_key.pub
.git-credentials
*.git-credentials
*.pfx
*.p12
*.keystore
credentials.json
service-account*.json
secrets.yml
secrets.yaml
.pypirc

# --- OS / editor metadata ---
.DS_Store
Thumbs.db
.idea/

# --- Claude Code machine-specific session files (manifest IS committed) ---
.claude/

# --- PHP / Composer ---
vendor/
.phpunit.result.cache
composer.phar

# --- Local-machine analysis bootstraps (contain machine-specific paths) ---
phpunit-bootstrap.php
phpunit-runner.php
phpstan-bootstrap.php
# phpstan.neon is tracked (relative paths only; documents the L6 gate for the module).
# phpstan-drupal-stubs and local overrides remain local-only.
phpstan-drupal-stubs*.php
phpcs-bootstrap.php

# --- Project log (maintained locally, not tracked) ---
PROJECT_LOG.md
project-log.html
license_service/PROJECT_LOG.md
license_service/project-log.html

# --- Drupal ---
sites/*/files/
sites/*/settings.local.php


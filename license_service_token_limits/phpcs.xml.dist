<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="license_service_token_limits">
  <file>src</file>
  <file>tests</file>
  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,txt,md,yml"/>
  <arg value="--colors"/>
  <arg value="-s"/>
</ruleset>

{
  "name": "license-service/license-service",
  "description": "Drupal module that connects a site to the License Verification Server and controls content access by license level and user role.",
  "type": "drupal-module",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Jeremiah Buttler",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-sodium": "*",
    "drupal/key": "^1.18"
  },
  "require-dev": {
    "drupal/coder": "^8.3",
    "mglaman/phpstan-drupal": "^1.2",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "Drupal\\license_service\\": "src/"
    }
  },
  "extra": {
    "drush": {
      "services": {
        "drush.services.yml": "^10 || ^12"
      }
    }
  }
}
